{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "AgentTemplates",
  "version": 1,
  "tags": {
    "agentcore:project-name": "AgentTemplates",
    "cost-center": "agent-platform"
  },
  "runtimes": [
    {
      "name": "generic_strands_sdk",
      "build": "Container",
      "entrypoint": "src/generic_agent_strands/shell/app.py",
      "codeLocation": "generic-agents/strands-sdk/",
      "buildContextPath": ".",
      "dockerfile": "generic-agents/strands-sdk/Dockerfile",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "eu-west-1"
        },
        {
          "name": "AGENT_MAX_USD",
          "value": "0.50"
        },
        {
          "name": "AGENT_MAX_TURNS",
          "value": "12"
        }
      ],
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      }
    },
    {
      "name": "generic_tools_mcp",
